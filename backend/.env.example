# Local development only. Replace DB_PASSWORD and JWT_SECRET before use.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmverse_db
DB_USERNAME=farmverse_user
DB_PASSWORD=replace-with-a-local-database-password

# Generate a random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Server Configuration
SERVER_PORT=8080

# CORS Allowed Origins (Comma-separated origins for your frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future Python ML Service URL (FastAPI)
PYTHON_ML_SERVICE_URL=http://localhost:8000
PYTHON_ML_SERVICE_TIMEOUT_MS=5000
